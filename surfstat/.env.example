# SurfStat configuration. install.sh writes this for you (generating real secrets
# and filling in the FloMorphic bits); the values here are the standalone
# defaults. Copy to .env to edit by hand.

# The published image to run.
SURFSTAT_IMAGE=mehdishokohi/surfstat:latest

# Hostname this instance is reached at (self-signed cert SAN for Superset's TLS).
PUBLIC_HOST=localhost

# Host ports to publish.
SURFSTAT_PORT=8080      # the panel (wapp + /api), via nginx
SUPERSET_PORT=8090     # Superset's own UI (direct/admin); 8088 is FloMorphic's canvas

# ── Superset ─────────────────────────────────────────────────────────────────
# REQUIRED in production — a real random key. install.sh generates one.
#   openssl rand -base64 42
SUPERSET_SECRET_KEY=CHANGE_ME_super_insecure_default_key
ADMIN_USER=admin
ADMIN_PASS=admin
ADMIN_EMAIL=admin@surfstat.local
# Load Superset's example datasets on first boot (needs internet).
LOAD_EXAMPLES=false

# ── SurfStat backend ──────────────────────────────────────────────────────────
# Keys the encryption of stored secrets — set a real random value in production.
SURFSTAT_APP_SECRET=dev-insecure-change-me
# Password for the internal `surfstat` Postgres role.
SURFSTAT_DB_PASS=surfstat

# ── FloMorphic (SurfStat runs as a FloMorphic plugin) ─────────────────────────
# The FloMorphic API base as reached over inflow_net, and the shared secret
# (FloMorphic's API_JWT_SECRET / INFLOW_INFRA_JWT_SECRET). install.sh captures
# these from the FloMorphic instance it finds or installs.
FLOMORPHIC_URL=http://flomorphic:8025
FLOMORPHIC_JWT_SECRET=
# Infra host for NATS (:4222) + the licence API (:8022) — the Infra container name on
# inflow_net.
INFRA_HOST=inflow-infra

# ── Access control ───────────────────────────────────────────────────────────
# The first administrator, created only on a database with no users yet. Leave
# the password blank and one is generated and printed to the container log
# once (`docker compose logs surfstat`); the account must change it at first
# sign-in, so the logged value stops working immediately.
SURFSTAT_ADMIN_USER=admin
SURFSTAT_ADMIN_PASSWORD=
SURFSTAT_ADMIN_EMAIL=

# Mark the session cookie Secure (HTTPS-only). Default false here because the
# published port is plain HTTP; set true once a TLS terminator is in front.
SURFSTAT_COOKIE_SECURE=false
