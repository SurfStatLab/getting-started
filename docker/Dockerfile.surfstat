# syntax=docker/dockerfile:1
#
# surfstat — the product image: the whole appliance in one container.
#
# Built FROM surfstat-base (postgres + superset + nginx + supervisord),
# this stage only adds the fast-moving parts — the surfstat-api Go binary and the
# compiled surfstat-wapp Vue panel — plus the nginx panel front door and the
# supervisor programs that start the API and provision its database. Nothing here
# rebuilds Superset, so product releases are quick.
#
# BUILD CONTEXT is the SurfStatProject root (the parent of getting-started), so the
# sibling source checkouts are available to COPY. The Makefile sets this up:
#   make build                         # host arch, as surfstat:local
#   make release VERSION=v0.1.0        # multi-arch, pushed
#
# The base it layers on is pinned with --build-arg BASE_IMAGE=... (the Makefile
# passes mehdishokohi/surfstat-base:$(BASE_VERSION)). Declared here in the global
# scope (before any FROM) so it can be used in the runtime FROM below.
ARG BASE_IMAGE=mehdishokohi/surfstat-base:latest

# The release tag this image is published under (the Makefile passes VERSION —
# the same value that tags the image). Both halves of the product are stamped
# with it: the API logs it at startup and serves it at /api/version, the panel
# bakes it into the bundle and shows it in the top bar. Global scope so every
# stage below can restate it. "dev" when nothing is passed.
ARG VERSION=dev

# ── the API (static Go binary, no cgo) ────────────────────────────────────────
# GOPROXY is overridable because the default CDN is not reachable everywhere:
# proxy.golang.org redirects module zips to storage.googleapis.com, and networks
# that block it answer 403 mid-download. It defaults to the goproxy.cn mirror for
# that reason; pass --build-arg GOPROXY= to fall back to the upstream default.
FROM golang:1.27 AS api-build
ARG GOPROXY=https://goproxy.cn,direct
ARG VERSION
WORKDIR /src
COPY surfstat-api/go.mod surfstat-api/go.sum ./
RUN go mod download
COPY surfstat-api/ ./
RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-s -w -X github.com/SurfStat/surfstat-api/internal/version.Version=${VERSION}" \
    -o /out/surfstat-api ./cmd/api

# ── the panel (Vue, built to static assets) ───────────────────────────────────
# Same-origin: VITE_SURFSTAT_API_URL=/ makes every backend call relative, so the
# nginx panel config proxies /api and there is no baked-in backend host. The
# Superset URL is only a Settings prefill (the backend owns the real connection).
FROM node:22-alpine AS wapp-build
ARG VITE_SURFSTAT_API_URL=/
ARG VITE_SUPERSET_URL=
ARG VERSION
RUN apk add --no-cache git && npm install -g pnpm@10
WORKDIR /src
COPY surfstat-wapp/ ./
RUN pnpm install --frozen-lockfile
RUN VITE_SURFSTAT_API_URL="$VITE_SURFSTAT_API_URL" VITE_SUPERSET_URL="$VITE_SUPERSET_URL" \
    VITE_SURFSTAT_VERSION="$VERSION" pnpm build

# ── runtime: layer onto the permanent base ────────────────────────────────────
ARG BASE_IMAGE=mehdishokohi/surfstat-base:latest
FROM ${BASE_IMAGE}
ARG VERSION

USER root

# Product bits.
COPY --from=api-build  /out/surfstat-api   /opt/surfstat/surfstat-api
COPY --from=wapp-build /src/dist          /srv/surfstat-www

# Packaging: the panel nginx config REPLACES the base's superset-only one; the
# supervisor program file is dropped into the base's include dir; the scripts run
# the API and provision its database.
COPY getting-started/docker/surfstat/nginx-surfstat.conf      /etc/nginx/conf.d/superset.conf
COPY getting-started/docker/surfstat/supervisor-surfstat.conf /etc/supervisor/conf.d/surfstat.conf
COPY getting-started/docker/surfstat/surfstat-db.sh \
     getting-started/docker/surfstat/run-surfstat.sh \
     getting-started/docker/surfstat/entrypoint.sh \
     /opt/surfstat/
RUN chmod +x /opt/surfstat/*.sh /opt/surfstat/surfstat-api

# The release this image was built from, readable without starting anything:
#   docker inspect -f '{{index .Config.Labels "org.opencontainers.image.version"}}' <image>
LABEL org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.title="surfstat"

# SurfStat runtime defaults (override at `docker run -e ...`). The Superset admin,
# secret key and public host are inherited from the base image's ENV.
# SURFSTAT_VERSION is informational — the version the API reports is stamped into
# the binary — so `docker exec ... printenv SURFSTAT_VERSION` answers from a shell.
ENV SURFSTAT_VERSION=${VERSION} \
    SURFSTAT_API_PORT=8091 \
    SURFSTAT_DB_NAME=surfstat \
    SURFSTAT_DB_USER=surfstat \
    SURFSTAT_DB_PASS=surfstat \
    SURFSTAT_APP_SECRET=dev-insecure-change-me \
    SURFSTAT_CORS_ORIGINS= \
    FLOMORPHIC_URL= \
    FLOMORPHIC_JWT_SECRET= \
    INFRA_HOST=

# 80 = the SurfStat panel (nginx: wapp + /api) · 8088 = Superset (direct/admin)
EXPOSE 80/tcp 8088/tcp

ENTRYPOINT ["/opt/surfstat/entrypoint.sh"]
